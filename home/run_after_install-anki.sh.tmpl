{{ if and (eq .chezmoi.os "linux") -}}
{{- $p := .profile_example -}}
{{- if eq .chezmoi.os "android" -}}{{- $p = .profile_termux_example -}}{{- end -}}
{{- if index . "profile" -}}
{{-   if eq .chezmoi.os "android" -}}{{- $p = mergeOverwrite $p .profile -}}
{{-   else -}}{{- $p = .profile -}}
{{-   end -}}
{{- end -}}
{{- if env "CHEZMOI_CI" -}}{{- $p = .profile_ci -}}{{- end -}}
{{- if index . "profile_host" -}}{{- $p = mergeOverwrite $p .profile_host -}}{{- end -}}
{{- if eq .chezmoi.os "android" -}}
{{- $p = mergeOverwrite $p (dict "features" (mergeOverwrite $p.features .profile_termux_example.features)) -}}
{{- end -}}
{{- $f := $p.features -}}
{{- if index $f "anki" -}}
#!/bin/bash
set -euo pipefail

# Official Linux package: https://docs.ankiweb.net/platform/linux/installing.html
# Runs on every chezmoi apply; upgrades when GitHub latest differs from installed.

if [[ "${CHEZMOI_CI:-}" == "1" ]]; then
  echo "CHEZMOI_CI=1; skipping Anki install"
  exit 0
fi

HOME_DIR="{{ .chezmoi.homeDir }}"
VERSION_FILE="$HOME_DIR/.local/state/anki/version"
CACHE_DIR="$HOME_DIR/.cache/anki-install"
SHARE_DIR="/usr/local/share/anki"
RELEASE_API="https://api.github.com/repos/ankitects/anki/releases/latest"

# GitHub release tarballs are large; SSL handshake / CDN timeouts are common.
# Resume into a cache so a later apply can continue instead of starting over.
curl_retry() {
  curl -fL --retry 5 --retry-delay 3 --retry-all-errors --retry-max-time 180 \
    --connect-timeout 30 --max-time 600 "$@"
}

anki_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "x86_64" ;;
    aarch64|arm64) echo "aarch64" ;;
    *)
      echo "WARN: Anki Linux package unsupported on arch=$(uname -m); skipping" >&2
      return 1
      ;;
  esac
}

# GitHub tags like 26.09 / 25.07.5 map to METADATA Version 26.9 / 25.7.5.
anki_pep440() {
  local IFS='.'
  local -a parts
  local out="" part
  read -ra parts <<< "$1"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    part=$((10#$part))
    out="${out:+$out.}$part"
  done
  printf '%s\n' "$out"
}

installed_pep440() {
  local files meta
  shopt -s nullglob
  files=("$SHARE_DIR"/app_packages/anki-*.dist-info/METADATA)
  shopt -u nullglob
  ((${#files[@]} > 0)) || return 1
  meta="$(sed -n 's/^Version:[[:space:]]*//p' "${files[0]}" | head -1)"
  [[ -n "$meta" ]] || return 1
  printf '%s\n' "$meta"
}

ensure_anki_deps() {
  export DEBIAN_FRONTEND=noninteractive
  # zstd for .tar.zst; remaining libs match the Anki Linux install docs (install.sh
  # also installs a broader Debian dependency set when run with sudo).
  sudo apt install -y -qq --no-install-recommends \
    zstd \
    libxcb-xinerama0 \
    libxcb-cursor0 \
    libnss3 \
    libxcb-icccm4 \
    libxcb-keysyms1
}

record_version() {
  mkdir -p "$(dirname "$VERSION_FILE")"
  printf '%s\n' "$1" > "$VERSION_FILE"
}

anki_current() {
  local installed_meta target_meta

  command -v anki >/dev/null 2>&1 || return 1
  [[ -x "$SHARE_DIR/anki" ]] || return 1

  if [[ -f "$VERSION_FILE" && "$(cat "$VERSION_FILE")" == "$target_tag" ]]; then
    return 0
  fi

  installed_meta="$(installed_pep440)" || return 1
  target_meta="$(anki_pep440 "$target_tag")"
  [[ "$installed_meta" == "$target_meta" ]] || return 1

  # Backfill state file so the next apply skips the METADATA probe.
  record_version "$target_tag"
  return 0
}

if ! command -v curl >/dev/null 2>&1; then
  echo "WARN: curl not found; skipping Anki install"
  exit 0
fi

arch="$(anki_arch)" || exit 0

echo "Resolving latest Anki release..."
target_tag="$(curl_retry -sS "$RELEASE_API" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)" || true
if [[ -z "$target_tag" ]]; then
  echo "WARN: could not resolve Anki latest release tag; skipping"
  exit 0
fi

if anki_current; then
  echo "Anki ${target_tag} already installed: $(command -v anki)"
  exit 0
fi

asset="anki-${target_tag}-linux-${arch}.tar.zst"
url="https://github.com/ankitects/anki/releases/download/${target_tag}/${asset}"

ensure_anki_deps

mkdir -p "$CACHE_DIR"
tmpdir="$(mktemp -d)"
cleanup() { rm -rf "$tmpdir"; }
trap cleanup EXIT

cached="$CACHE_DIR/$asset"
echo "Installing Anki ${target_tag} (${asset})..."
if ! curl_retry -C - --progress-bar "$url" -o "$cached"; then
  echo "WARN: failed to download Anki ${target_tag} from GitHub (network timeout)."
  echo "      Partial download kept at $cached; re-run: chezmoi apply"
  exit 0
fi

echo "Extracting Anki..."
if ! tar xaf "$cached" -C "$tmpdir" 2>/dev/null; then
  if ! tar --use-compress-program=unzstd -xf "$cached" -C "$tmpdir"; then
    echo "WARN: Anki archive is corrupt (likely a partial download); deleting $cached"
    rm -f "$cached"
    exit 0
  fi
fi

# Older releases used anki-linux/; 26.09+ uses anki-<pep440>-linux-<arch>.tar/.
install_sh="$(find "$tmpdir" -maxdepth 3 -type f -name install.sh -print -quit)"
if [[ -z "$install_sh" || ! -x "$install_sh" ]]; then
  echo "WARN: Anki install.sh missing after extract; skipping"
  exit 0
fi
install_dir="$(dirname "$install_sh")"

echo "Installing Anki to /usr/local..."
(
  cd "$install_dir"
  sudo ./install.sh
)

if ! command -v anki >/dev/null 2>&1; then
  echo "WARN: Anki install finished but 'anki' is not on PATH"
  exit 0
fi

record_version "$target_tag"
rm -f "$cached"
echo "Anki installed: $(command -v anki) (${target_tag})"
cat <<'EOF'

Anki is installed. Launch with: anki
Installation guide: https://docs.ankiweb.net/platform/linux/installing.html
EOF
{{- end -}}
{{ end -}}
