{{ if eq .chezmoi.os "linux" -}}
{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{- $f := $p.features -}}
{{- if index $f "unreal" -}}
#!/usr/bin/env bash
set -euo pipefail

ENGINE="${UE_ENGINE:-{{ $p.unreal_engine_path | default "" }}}"
EDITOR="$ENGINE/Engine/Binaries/Linux/UnrealEditor"

if [[ ! -x "$EDITOR" ]]; then
  echo "UnrealEditor not found at $EDITOR" >&2
  exit 1
fi

export SDL_VIDEODRIVER=x11
export SDL_VIDEO_DRIVER=x11
export GDK_BACKEND=x11

# Prefer discrete NVIDIA for Vulkan on Optimus laptops (Intel iGPU often fails UE SM5/SM6 checks).
if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
  for icd in \
    /usr/share/vulkan/icd.d/nvidia_icd.json \
    /usr/share/vulkan/icd.d/nvidia_icd.x86_64.json
  do
    if [[ -f "$icd" ]]; then
      export VK_ICD_FILENAMES="$icd"
      break
    fi
  done
fi

if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "WARN: NVIDIA driver mismatch or GPU unavailable (nvidia-smi failed)." >&2
  echo "WARN: Reboot so the kernel module matches userspace, then retry." >&2
fi

# On Sway/Wayland+XWayland, Slate tooltips and notification toasts steal the first
# click (and often leave "Dismiss" buttons dead). Disable both at startup.
# Pass UE_EXTRA_ARGS="-sm5" if Vulkan SM6 fails on your GPU.
extra_args=()
if [[ -n "${UE_EXTRA_ARGS:-}" ]]; then
  # shellcheck disable=SC2206
  extra_args=(${UE_EXTRA_ARGS})
fi

exec "$EDITOR" \
  -ExecCmds="Slate.EnableTooltips 0;Slate.bAllowNotifications 0" \
  "${extra_args[@]}" \
  "$@"
{{- end -}}
{{ end -}}
