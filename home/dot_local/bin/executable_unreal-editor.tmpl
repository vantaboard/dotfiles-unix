{{ if eq .chezmoi.os "linux" -}}
{{- $p := .profile_example -}}
{{- if index . "profile" -}}{{- $p = .profile -}}{{- end -}}
{{- if env "CHEZMOI_CI" -}}{{- $p = .profile_ci -}}{{- end -}}
{{- if index . "profile_host" -}}{{- $p = mergeOverwrite $p .profile_host -}}{{- end -}}
{{- $f := $p.features -}}
{{- if index $f "unreal" -}}
#!/usr/bin/env bash
set -euo pipefail

ENGINE="${UE_ENGINE:-{{ $p.unreal_engine_path | default "" }}}"
EDITOR="$ENGINE/Engine/Binaries/Linux/UnrealEditor"

if [[ ! -x "$EDITOR" ]]; then
  echo "UnrealEditor not found at $EDITOR" >&2
  exit 1
fi

export SDL_VIDEODRIVER=x11
export SDL_VIDEO_DRIVER=x11
export GDK_BACKEND=x11

# Prefer discrete NVIDIA for Vulkan on Optimus laptops (Intel iGPU often fails UE SM5/SM6 checks).
if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
  for icd in \
    /usr/share/vulkan/icd.d/nvidia_icd.json \
    /usr/share/vulkan/icd.d/nvidia_icd.x86_64.json
  do
    if [[ -f "$icd" ]]; then
      export VK_ICD_FILENAMES="$icd"
      break
    fi
  done
fi

if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "WARN: NVIDIA driver mismatch or GPU unavailable (nvidia-smi failed)." >&2
  echo "WARN: Reboot so the 595 kernel module loads, then retry." >&2
fi

# -sm5: project's DefaultEngine.ini may request SM6; force SM5 for laptop NVIDIA stability.
exec "$EDITOR" -sm5 "$@"
{{- end -}}
{{ end -}}
