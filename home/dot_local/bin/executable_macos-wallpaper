#!/bin/bash
# Same images and left-to-right order as sway-wallpaper (kanshi post-switch).
# Each display gets its own picture. A closed laptop lid is listed after the
# screens that are currently on.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  exit 0
fi

WALL_DIR="${HOME}/.wallpapers"
paths=(
  "$WALL_DIR/pexels-pachon-in-motion-426015731-18337644.jpg"
  "$WALL_DIR/pexels-pachon-in-motion-426015731-18545010.jpg"
  "$WALL_DIR/pexels-vahapdmr-18515329.jpg"
)

for path in "${paths[@]}"; do
  if [[ ! -f "$path" ]]; then
    echo "macos-wallpaper: missing $path" >&2
    exit 0
  fi
done

# NSWorkspace setDesktopImageURL:forScreen: writes the last image onto every
# display. System Events can set each desktop's picture on its own.
display_names=()
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  display_names+=("$name")
done < <(osascript -l JavaScript <<'JS'
function run() {
  ObjC.import("AppKit");
  var all = $.NSScreen.screens;
  var screens = [];
  for (var i = 0; i < all.count; i++) screens.push(all.objectAtIndex(i));
  screens.sort(function (a, b) { return a.frame.origin.x - b.frame.origin.x; });
  var ordered = [];
  var seen = {};
  for (var i = 0; i < screens.length; i++) {
    var name = screens[i].localizedName.js;
    ordered.push(name);
    seen[name] = true;
  }
  var se = Application("System Events");
  var desks = se.desktops();
  for (var i = 0; i < desks.length; i++) {
    var name = desks[i].displayName();
    if (!seen[name]) ordered.push(name);
  }
  return ordered.join("\n");
}
JS
)

last_path="${paths[$((${#paths[@]} - 1))]}"
applescript='tell application "System Events"'
assigned=0
for name in "${display_names[@]}"; do
  [[ -n "$name" ]] || continue
  path="${paths[$assigned]:-$last_path}"
  assigned=$((assigned + 1))
  esc_name=${name//\\/\\\\}
  esc_name=${esc_name//\"/\\\"}
  esc_path=${path//\\/\\\\}
  esc_path=${esc_path//\"/\\\"}
  applescript+=$'\n'"try"$'\n'"set picture of (first desktop whose display name is \"${esc_name}\") to POSIX file \"${esc_path}\""$'\n'"end try"
  echo "macos-wallpaper: ${name} <- $(basename "$path")"
done
applescript+=$'\n''end tell'
osascript <<<"$applescript" >/dev/null
