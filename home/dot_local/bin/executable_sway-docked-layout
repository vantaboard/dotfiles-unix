#!/usr/bin/bash
# Restore docked/undocked output positions after sway reload scrambles them.
# Layouts come from ~/.config/sway/displays.json (profile.displays).
set -euo pipefail

[[ "${XDG_SESSION_TYPE:-}" == "wayland" && -n "${SWAYSOCK:-}" ]] || exit 0
exec "$HOME/.local/bin/sway-displays" apply
