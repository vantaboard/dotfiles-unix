#!/usr/bin/env bash
# Usage: aerospace-focus left|right|up|down|dfs-next|dfs-prev
#
# macOS activates an app's most recent window, which can live on another
# AeroSpace workspace. After an in-workspace focus move, if focus lands on
# another workspace, refocus that app's window on the workspace we started from.
# left/right fall through to the neighboring monitor at the workspace edge.
set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

direction="${1:?usage: aerospace-focus left|right|up|down|dfs-next|dfs-prev}"

origin_ws="$(aerospace list-workspaces --focused)"
origin_win="$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)"

if ! aerospace focus --boundaries workspace --boundaries-action fail "$direction" 2>/dev/null; then
  case "$direction" in
    left | right)
      exec aerospace focus --boundaries all-monitors-outer-frame \
        --boundaries-action stop "$direction"
      ;;
  esac
  exit 0
fi

for _ in {1..6}; do
  read -r ws app < <(aerospace list-windows --focused \
    --format '%{workspace} %{app-bundle-id}')
  if [[ -n "${ws:-}" && "$ws" != "$origin_ws" ]]; then
    target="$(aerospace list-windows --workspace "$origin_ws" \
      --app-bundle-id "$app" --format '%{window-id}' |
      grep -Fxv "${origin_win:-none}" | head -1)"
    [[ -n "$target" ]] || exit 0
    for _ in {1..3}; do
      aerospace focus --window-id "$target"
      [[ "$(aerospace list-windows --focused --format '%{window-id}')" == "$target" ]] && exit 0
      sleep 0.05
    done
    exit 0
  fi
  sleep 0.05
done
