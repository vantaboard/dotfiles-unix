#!/usr/bin/bash
# Wait for NVIDIA dock MST to enumerate before the first compositor modeset.
# Applying a 2-stream layout too early can lock MST payloads so the third
# monitor never appears (DP-3 stays disconnected).
set -uo pipefail

TIMEOUT="${1:-25}"

dock_usb_present() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        case "$(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)" in
            2109:2822|2109:0822|0bda:5411) return 0 ;;
        esac
    done
    return 1
}

dp_connected_count() {
    local n=0 p
    for p in /sys/class/drm/card*-DP-*/status; do
        [[ -e "$p" ]] || continue
        [[ "$(cat "$p" 2>/dev/null)" == "connected" ]] && ((n++)) || true
    done
    echo "$n"
}

dock_usb_present || exit 0

count="$(dp_connected_count)"
[[ "$count" -ge 3 ]] && exit 0

attempt=0
while (( attempt < TIMEOUT )); do
    count="$(dp_connected_count)"
    [[ "$count" -ge 3 ]] && exit 0
    sleep 1
    ((attempt++)) || true
done
exit 0
