{{ if eq .chezmoi.os "linux" -}}
{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{- $f := $p.features -}}
{{- if index $f "godot" -}}
[Desktop Entry]
Version=1.0
Type=Application
Name=Godot Engine
GenericName=Game Engine
Comment=Multi-platform 2D and 3D game engine
Exec={{ .chezmoi.homeDir }}/.local/bin/godot %f
TryExec={{ .chezmoi.homeDir }}/.local/bin/godot
Icon=godot
Terminal=false
Categories=Development;IDE;
MimeType=application/x-godot-project;
Keywords=godot;gdscript;game;engine;
{{- end -}}
{{ end -}}
