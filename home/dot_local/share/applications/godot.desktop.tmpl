{{ if eq .chezmoi.os "linux" -}}
{{- $p := .profile_example -}}
{{- if index . "profile" -}}{{- $p = .profile -}}{{- end -}}
{{- if env "CHEZMOI_CI" -}}{{- $p = .profile_ci -}}{{- end -}}
{{- if index . "profile_host" -}}{{- $p = mergeOverwrite $p .profile_host -}}{{- end -}}
{{- $f := $p.features -}}
{{- if index $f "godot" -}}
[Desktop Entry]
Version=1.0
Type=Application
Name=Godot Engine
GenericName=Game Engine
Comment=Multi-platform 2D and 3D game engine
Exec={{ .chezmoi.homeDir }}/.local/bin/godot %f
TryExec={{ .chezmoi.homeDir }}/.local/bin/godot
Icon=godot
Terminal=false
Categories=Development;IDE;
MimeType=application/x-godot-project;
Keywords=godot;gdscript;game;engine;
{{- end -}}
{{ end -}}
