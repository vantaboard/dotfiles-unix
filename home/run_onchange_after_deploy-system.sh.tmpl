{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

{{- $p := .profile_example -}}
{{- if eq .chezmoi.os "android" -}}{{- $p = .profile_termux_example -}}{{- end -}}
{{- if index . "profile" -}}
{{-   if eq .chezmoi.os "android" -}}{{- $p = mergeOverwrite $p .profile -}}
{{-   else -}}{{- $p = .profile -}}
{{-   end -}}
{{- end -}}
{{- if env "CHEZMOI_CI" -}}{{- $p = .profile_ci -}}{{- end -}}
{{- if index . "profile_host" -}}{{- $p = mergeOverwrite $p .profile_host -}}{{- end -}}
{{- if eq .chezmoi.os "android" -}}
{{- $p = mergeOverwrite $p (dict "features" (mergeOverwrite $p.features .profile_termux_example.features)) -}}
{{- end -}}
{{- $deploy := $p.system_deploy | default list }}

SOURCE="{{ .chezmoi.sourceDir }}/system"

# hash: {{ $deploy | toYaml | sha256sum }}
# hash: {{ include "system/bin/sway-session" | sha256sum }}
# hash: {{ include "system/gdm3/custom.conf" | sha256sum }}
# hash: {{ include "system/wayland-sessions/sway.desktop" | sha256sum }}
# hash: {{ include "system/grub/default" | sha256sum }}
# hash: {{ include "system/keyd/default.conf" | sha256sum }}
# hash: {{ include "system/libinput/local-overrides.quirks.tmpl" | sha256sum }}
# hash: {{ include "system/udev/99-input-permissions.rules" | sha256sum }}
# hash: {{ include "system/udev/99-wake-sources.rules" | sha256sum }}
# hash: {{ include "system/ssh/sshd_config.d/99-keyonly-port.conf" | sha256sum }}
# hash: {{ include "system/ssh/ssh.socket.d/port.conf" | sha256sum }}
# hash: {{ include "system/systemd-sleep/displays-resume.tmpl" | sha256sum }}
# hash: {{ include "system/modprobe.d/nvidia-s0ix.conf" | sha256sum }}
# hash: {{ include "system/modprobe.d/nvidia-drm-nofbdev.conf" | sha256sum }}
# hash: {{ include "system/bin/wait-dock-mst" | sha256sum }}
# hash: {{ include "system/modprobe.d/snd-hda-intel-long-hdmi.conf" | sha256sum }}
# hash: {{ include "system/alsa-card-profile/mixer/profile-sets/hdmi-force-available.conf" | sha256sum }}
# hash: {{ include "system/alsa-card-profile/mixer/paths/hdmi-output-0-force.conf" | sha256sum }}
# hash: {{ include "system/systemd/gdm.service.d/wait-for-nvidia.conf" | sha256sum }}
# hash: {{ include "system/systemd/logind.conf.d/ignore-lid-switch.conf" | sha256sum }}
# hash: {{ include "system/systemd/llama-swap.service.tmpl" | sha256sum }}

deploy_file() {
  local src="$1"
  local dest="$2"
  local mode="${3:-644}"
  sudo install -Dm"$mode" "$src" "$dest"
}

deploy_dir_file() {
  local src="$1"
  local dest="$2"
  local mode="${3:-644}"
  sudo install -d "$(dirname "$dest")"
  sudo install -m"$mode" "$src" "$dest"
}

if [[ "${CHEZMOI_SKIP_SYSTEM_DEPLOY:-}" == "1" ]]; then
  echo "CHEZMOI_SKIP_SYSTEM_DEPLOY=1; skipping system deploy"
  exit 0
fi

has_deploy() {
  local key="$1"
{{- if $deploy }}
  case "$key" in
{{- range $deploy }}
    {{ . }}) return 0 ;;
{{- end }}
  esac
  return 1
{{- else }}
  return 0
{{- end }}
}

if has_deploy displays_resume && command -v systemctl >/dev/null 2>&1; then
  TMP_SLEEP="$(mktemp)"
  chezmoi execute-template < "$SOURCE/systemd-sleep/displays-resume.tmpl" > "$TMP_SLEEP"
  deploy_file "$TMP_SLEEP" /usr/lib/systemd/system-sleep/displays-resume 755
  rm -f "$TMP_SLEEP"
  # Retire the old sleep.target unit — its ExecStop never ran on wake and the user
  # copy referenced a non-existent user sleep.target.
  sudo systemctl disable --now displays-resume.service 2>/dev/null || true
  sudo rm -f /etc/systemd/system/displays-resume.service
  sudo systemctl daemon-reload 2>/dev/null || true
  # autorandr (xrandr/X11) fights kanshi on sway Wayland and broke dock replug recovery.
  sudo systemctl unmask autorandr.service 2>/dev/null || true
  sudo systemctl disable --now autorandr-lid-listener.service 2>/dev/null || true
  if dpkg-query -W -f='${Status}' autorandr 2>/dev/null | grep -q 'install ok installed'; then
    sudo apt-get remove -y --purge autorandr
  fi
  # NVIDIA + s2idle: without S0ix power management, VRAM restore is broken on
  # wake and sway cannot light up any output (see the conf file for details).
  # The nvidia modules are baked into the initramfs, so a rebuild is needed
  # for the option to take effect at boot.
  if [[ -d /etc/modprobe.d && -d /proc/driver/nvidia ]]; then
    nvidia_modprobe_changed=0
    if ! cmp -s "$SOURCE/modprobe.d/nvidia-s0ix.conf" /etc/modprobe.d/nvidia-s0ix.conf; then
      deploy_file "$SOURCE/modprobe.d/nvidia-s0ix.conf" /etc/modprobe.d/nvidia-s0ix.conf
      nvidia_modprobe_changed=1
      echo "NVIDIA S0ix power management enabled; reboot for suspend/resume fix"
    fi
    if ! cmp -s "$SOURCE/modprobe.d/nvidia-drm-nofbdev.conf" /etc/modprobe.d/nvidia-drm-nofbdev.conf 2>/dev/null; then
      deploy_file "$SOURCE/modprobe.d/nvidia-drm-nofbdev.conf" /etc/modprobe.d/nvidia-drm-nofbdev.conf
      nvidia_modprobe_changed=1
      echo "NVIDIA DRM fbdev disabled; reboot so MST can enumerate all dock displays"
    fi
    if (( nvidia_modprobe_changed )) && command -v update-initramfs >/dev/null 2>&1; then
      sudo update-initramfs -u
    fi
  fi
fi

if has_deploy sway_session; then
  deploy_file "$SOURCE/bin/sway-session" /usr/local/bin/sway-session 755
  deploy_file "$SOURCE/bin/wait-dock-mst" /usr/local/bin/wait-dock-mst 755
  deploy_file "$SOURCE/wayland-sessions/sway.desktop" /usr/share/wayland-sessions/sway.desktop
  deploy_dir_file "$SOURCE/systemd/logind.conf.d/ignore-lid-switch.conf" \
    /etc/systemd/logind.conf.d/ignore-lid-switch.conf
  sudo systemctl reload systemd-logind 2>/dev/null || true
  if [[ -d /etc/gdm3 ]]; then
    deploy_file "$SOURCE/gdm3/custom.conf" /etc/gdm3/custom.conf
    echo "GDM Wayland enabled; log out (or reboot) for Sway to appear in the session menu"
    # Hybrid Intel+NVIDIA: the greeter hard-freezes if the slow-initializing
    # NVIDIA DRM device appears while it is already running (mutter hotplug
    # bug; details in the conf file). Make gdm.service wait for the card node
    # so the greeter never sees the hotplug.
    nvidia_pci=""
    for dev in /sys/bus/pci/devices/*; do
      [[ "$(cat "$dev/vendor" 2>/dev/null)" == "0x10de" ]] || continue
      case "$(cat "$dev/class" 2>/dev/null)" in 0x030*) ;; *) continue ;; esac
      nvidia_pci="$(basename "$dev")"
      break
    done
    if [[ -n "$nvidia_pci" ]]; then
      TMP_GDM_WAIT="$(mktemp)"
      sed "s/@NVIDIA_PCI@/$nvidia_pci/" \
        "$SOURCE/systemd/gdm.service.d/wait-for-nvidia.conf" > "$TMP_GDM_WAIT"
      deploy_file "$TMP_GDM_WAIT" /etc/systemd/system/gdm.service.d/wait-for-nvidia.conf
      rm -f "$TMP_GDM_WAIT"
      sudo systemctl daemon-reload 2>/dev/null || true
      echo "GDM will wait for NVIDIA DRM device $nvidia_pci (greeter freeze workaround)"
    fi
  fi
fi

if has_deploy grub && [[ -f /etc/default/grub ]] && command -v update-grub >/dev/null 2>&1; then
  deploy_file "$SOURCE/grub/default" /etc/default/grub
  sudo update-grub 2>/dev/null || true
fi

if has_deploy ssh && [[ -d /etc/ssh ]]; then
  deploy_dir_file "$SOURCE/ssh/sshd_config.d/99-keyonly-port.conf" \
    /etc/ssh/sshd_config.d/99-keyonly-port.conf
  deploy_dir_file "$SOURCE/ssh/ssh.socket.d/port.conf" \
    /etc/systemd/system/ssh.socket.d/port.conf
  if command -v systemctl >/dev/null 2>&1; then
    sudo mkdir -p /etc/systemd/system/ssh.service.requires
    sudo ln -sf /usr/lib/systemd/system/ssh.socket \
      /etc/systemd/system/ssh.service.requires/ssh.socket 2>/dev/null || true
    sudo systemctl daemon-reload 2>/dev/null || true
    sudo systemctl enable ssh.socket 2>/dev/null || true
  fi
fi

if has_deploy llama && { command -v llama-swap >/dev/null 2>&1 || [[ -x /usr/local/bin/llama-swap ]]; }; then
  TMP_LLAMA_SWAP="$(mktemp)"
  chezmoi execute-template < "$SOURCE/systemd/llama-swap.service.tmpl" > "$TMP_LLAMA_SWAP"
  deploy_file "$TMP_LLAMA_SWAP" /etc/systemd/system/llama-swap.service
  rm -f "$TMP_LLAMA_SWAP"
  sudo systemctl daemon-reload 2>/dev/null || true
  # Retire Ollama if previously deployed.
  sudo systemctl disable --now ollama.service 2>/dev/null || true
  sudo rm -f /etc/systemd/system/ollama.service
  sudo rm -rf /etc/systemd/system/ollama.service.d
fi

if has_deploy keyd && {
  command -v keyd >/dev/null 2>&1 ||
  command -v keyd.rvaiya >/dev/null 2>&1 ||
  [[ -x /usr/bin/keyd.rvaiya ]]
}; then
  sudo install -d /etc/keyd
  deploy_file "$SOURCE/keyd/default.conf" /etc/keyd/default.conf
  sudo systemctl enable keyd 2>/dev/null || true
  sudo systemctl restart keyd 2>/dev/null || true
fi

if has_deploy libinput; then
  TMP_QUIRKS="$(mktemp)"
  chezmoi execute-template < "$SOURCE/libinput/local-overrides.quirks.tmpl" > "$TMP_QUIRKS"
  sudo install -d /etc/libinput
  deploy_file "$TMP_QUIRKS" /etc/libinput/local-overrides.quirks
  rm -f "$TMP_QUIRKS"
fi

if has_deploy udev; then
  deploy_file "$SOURCE/udev/99-input-permissions.rules" \
    /etc/udev/rules.d/99-input-permissions.rules
  if ! id -nG "{{ .chezmoi.username }}" | tr ' ' '\n' | grep -qx input; then
    sudo usermod -aG input "{{ .chezmoi.username }}"
    echo "Added {{ .chezmoi.username }} to input group; log out/in for group membership"
  fi
  sudo udevadm control --reload-rules 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
fi

if has_deploy wake_sources; then
  deploy_file "$SOURCE/udev/99-wake-sources.rules" \
    /etc/udev/rules.d/99-wake-sources.rules
  sudo udevadm control --reload-rules 2>/dev/null || true
  # Trigger so already-attached devices are disarmed now instead of only after
  # the next replug or reboot.
  sudo udevadm trigger --subsystem-match=usb --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=net --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=platform --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=pci --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=i2c --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=serio --action=change 2>/dev/null || true
  sudo udevadm trigger --subsystem-match=power_supply --action=change 2>/dev/null || true
fi

if has_deploy hdmi_audio; then
  # snd_hda_intel power_save/snoop + ACP profile-set that ignores ELD/jack for
  # long passive HDMI. WirePlumber Lua overrides live under ~/.config (chezmoi).
  deploy_file "$SOURCE/modprobe.d/snd-hda-intel-long-hdmi.conf" \
    /etc/modprobe.d/snd-hda-intel-long-hdmi.conf
  ACP_ROOT=/usr/share/alsa-card-profile/mixer
  deploy_file "$SOURCE/alsa-card-profile/mixer/profile-sets/hdmi-force-available.conf" \
    "$ACP_ROOT/profile-sets/hdmi-force-available.conf"
  for n in 0 1 2 3; do
    deploy_file "$SOURCE/alsa-card-profile/mixer/paths/hdmi-output-${n}-force.conf" \
      "$ACP_ROOT/paths/hdmi-output-${n}-force.conf"
  done
  sudo rm -f "$ACP_ROOT/paths/hdmi-output-force.conf.common"
  if command -v update-initramfs >/dev/null 2>&1; then
    sudo update-initramfs -u
  fi
  # Classic pulseaudio holds /dev/snd and leaves PipeWire on Dummy Output.
  # pipewire-pulse already provides the PulseAudio socket compatibility layer.
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user mask pulseaudio.service pulseaudio.socket 2>/dev/null || true
  fi
  echo "hdmi_audio: snd_hda_intel power_save/snoop disabled; ACP force-available profiles installed"
  echo "hdmi_audio: reboot for snoop=0; WirePlumber Lua is under ~/.config/wireplumber/main.lua.d/"
fi

if has_deploy hibernate && [[ -d /etc/default/grub.d ]] && command -v update-grub >/dev/null 2>&1; then
  swap_file="$(awk '$2 == "file" { print $1; exit }' /proc/swaps)"
  if [[ -z "$swap_file" ]]; then
    echo "hibernate: no swap file active; skipping resume configuration"
  else
    root_uuid="$(findmnt -no UUID -T /)"
    # The kernel needs the swap file's first physical block to find the image.
    # filefrag reports it in filesystem blocks, which on ext4 matches the
    # page-sized units resume_offset expects. It changes every time the file is
    # recreated, so re-derive it here rather than pinning a value in the repo.
    # awk must not exit on the first match: a multi-GB swap file has many extents
    # and closing the pipe early kills filefrag with SIGPIPE, which pipefail turns
    # into a fatal 141 for the whole script.
    swap_offset="$(sudo filefrag -v "$swap_file" |
      awk '$1 == "0:" { gsub(/\.\./, "", $4); print $4 }')"

    ram_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
    swap_kb="$(awk '$2 == "file" { print $3; exit }' /proc/swaps)"
    if (( swap_kb < ram_kb )); then
      echo "hibernate: $swap_file is smaller than RAM ($((swap_kb / 1024))MB < $((ram_kb / 1024))MB);" \
        "hibernation will fail once memory use exceeds it. Recreate it larger with" \
        "swapoff, dd, mkswap, swapon, then re-run chezmoi apply to refresh resume_offset."
    fi

    changed=0
    TMP_RESUME="$(mktemp)"
    {
      echo "# Deployed by chezmoi (deploy-system). Hibernation is unavailable unless the"
      echo "# kernel knows both which device holds the image and the offset of the swap"
      echo "# file inside it; with neither set, /sys/power/disk reads 'disabled' and"
      echo "# hibernating silently cold-boots instead of resuming."
      echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT resume=UUID=$root_uuid resume_offset=$swap_offset\""
    } > "$TMP_RESUME"
    if ! sudo cmp -s "$TMP_RESUME" /etc/default/grub.d/99-resume.cfg; then
      deploy_file "$TMP_RESUME" /etc/default/grub.d/99-resume.cfg
      sudo update-grub 2>/dev/null || true
      changed=1
    fi
    rm -f "$TMP_RESUME"

    # initramfs-tools only recognizes swap *block devices*. Our resume target is a
    # swap *file* on the root FS, so RESUME=UUID=<root> always warns "no matching
    # swap device". Kernel cmdline (resume= + resume_offset= above) is what
    # actually enables hibernation resume; set RESUME=none to silence the warning
    # and stop mkinitramfs from auto-picking some other swap partition.
    if [[ -d /etc/initramfs-tools/conf.d ]]; then
      TMP_IRFS="$(mktemp)"
      printf '%s\n' \
        '# Deployed by chezmoi (deploy-system). Swapfile hibernation uses GRUB' \
        '# resume=/resume_offset=; RESUME=none avoids a false "no matching swap"' \
        '# warning (root UUID is ext4, not a swap device).' \
        'RESUME=none' > "$TMP_IRFS"
      if ! sudo cmp -s "$TMP_IRFS" /etc/initramfs-tools/conf.d/resume; then
        deploy_file "$TMP_IRFS" /etc/initramfs-tools/conf.d/resume
        sudo update-initramfs -u 2>/dev/null || true
        changed=1
      fi
      rm -f "$TMP_IRFS"
    fi

    if (( changed )); then
      echo "hibernate: resume=UUID=$root_uuid resume_offset=$swap_offset configured; reboot to enable"
    fi
  fi
fi

echo "System configuration deployed"
{{ end -}}
