{{ if eq .chezmoi.os "android" -}}
#!{{ joinPath (dir .chezmoi.homeDir) "usr/bin/sh" }}
set -eu

# hash: {{ .packages.termux.pkg | toYaml | sha256sum }}
# hash: {{ include ".chezmoidata/pkg-manual.yaml" | sha256sum }}

{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{ $f := $p.features }}

# hash: {{ index $f "llama" }}

if ! command -v pkg >/dev/null 2>&1; then
  echo "pkg not found; not a Termux environment, skipping"
  exit 0
fi

# Termux is rolling-release: installing packages without a full upgrade first
# leaves openssl/libcurl/libngtcp2 out of sync (breaks curl and git-remote-https).
# Use apt directly — it does not depend on curl the way pkg's mirror checks do.
export DEBIAN_FRONTEND=noninteractive
apt update
apt full-upgrade -y \
  -o Dpkg::Options::=--force-confdef \
  -o Dpkg::Options::=--force-confold
apt install -y --no-install-recommends \
{{- range .packages.termux.pkg }}
  {{ . }} \
{{- end }}
{{- if not (env "CHEZMOI_CI") }}
{{- with index . "pkg_manual" }}
{{- with .packages }}
{{- range $pkg, $meta := . }}
{{- if eq $meta.status "install" }}
  {{ $pkg }} \
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- if index $f "llama" }}
  llama-cpp \
  termux-services \
{{- end }}

echo "Termux packages installed"
{{ else if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/setup-catalog.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/profile.example.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/profile.wsl.example.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/apt-manual.yaml" | sha256sum }}

{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{- $aptExclude := default (list) .packages.ubuntu.apt_exclude -}}
{{- $aptExcludeMap := dict -}}
{{- range $aptExclude -}}
{{- $_ := set $aptExcludeMap . true -}}
{{- end -}}
{{- $needsKeyd := false -}}
{{- $needsFastfetch := false -}}
{{- $needsGh := false -}}
{{- if not (env "CHEZMOI_CI") -}}
{{- if $p.packages -}}
{{- range $p.packages -}}
{{- if eq . "keyd" -}}{{- $needsKeyd = true -}}{{- end -}}
{{- if eq . "fastfetch" -}}{{- $needsFastfetch = true -}}{{- end -}}
{{- if eq . "gh" -}}{{- $needsGh = true -}}{{- end -}}
{{- end -}}
{{- else -}}
{{- range .packages.ubuntu.apt -}}
{{- if eq . "keyd" -}}{{- $needsKeyd = true -}}{{- end -}}
{{- if eq . "fastfetch" -}}{{- $needsFastfetch = true -}}{{- end -}}
{{- if eq . "gh" -}}{{- $needsGh = true -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- end }}

if ! command -v apt >/dev/null 2>&1; then
  if [[ -x /usr/bin/apt ]]; then
    export PATH="/usr/bin:/usr/sbin:${PATH:-}"
  else
    echo "apt not found; skipping package installation"
    exit 0
  fi
fi

export DEBIAN_FRONTEND=noninteractive

is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]] && return 0
  [[ -r /proc/version ]] && grep -qi microsoft /proc/version && return 0
  return 1
}

headless_skip_pkg() {
  case "$1" in
{{- range (default (list) .packages.ubuntu.apt_headless_exclude) }}
    {{ . }}) return 0 ;;
{{- end }}
  esac
  return 1
}

drop_wsl_graphical_pkgs() {
  local pkg
  local kept=()
  for pkg in "${available_pkgs[@]}"; do
    if headless_skip_pkg "$pkg"; then
      continue
    fi
    kept+=("$pkg")
  done
  available_pkgs=("${kept[@]}")
}

apt_pkg_candidate() {
  # awk exits after the first match; without `|| true`, pipefail turns apt-cache's
  # SIGPIPE into exit 141 and aborts the script under `set -e`.
  apt-cache policy "$1" 2>/dev/null | awk -F': ' '/Candidate:/ {print $2; exit}' || true
}

ensure_add_apt_repository() {
  if command -v add-apt-repository >/dev/null 2>&1; then
    return 0
  fi
  echo "Installing software-properties-common for add-apt-repository..."
  sudo apt install -y -qq --no-install-recommends software-properties-common
}

ensure_universe_repo() {
  if grep -rqE '^[^#]*\buniverse\b' /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null; then
    return 0
  fi
  if command -v lsb_release >/dev/null 2>&1 && [[ "$(lsb_release -si 2>/dev/null)" == "Ubuntu" ]]; then
    ensure_add_apt_repository
    echo "universe repository not enabled; enabling (needed for gh, glab, eza, zoxide on some hosts)"
    sudo add-apt-repository -y universe
    sudo apt update -qq
  fi
}

ensure_gh_repo() {
  local candidate
  candidate="$(apt_pkg_candidate gh)" || candidate=""
  if [[ -n "$candidate" && "$candidate" != "(none)" ]]; then
    return 0
  fi
  local list=/etc/apt/sources.list.d/github-cli.list
  local keyring=/usr/share/keyrings/githubcli-archive-keyring.gpg
  if [[ -f "$list" && -f "$keyring" ]]; then
    sudo apt update -qq
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "WARN: gh not available and curl missing; skipping GitHub CLI repo setup"
    return 0
  fi
  echo "gh not in repos; adding GitHub CLI apt repository..."
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo dd of="$keyring" bs=8192 conv=cp fsync status=none
  echo "deb [arch=$(dpkg --print-architecture) signed-by=${keyring}] https://cli.github.com/packages stable main" \
    | sudo tee "$list" >/dev/null
  sudo apt update -qq
}

sudo apt update -qq
ensure_universe_repo
{{- if $needsGh }}
ensure_gh_repo
{{- end }}
{{- if $needsKeyd }}

if ! apt show keyd >/dev/null 2>&1; then
  ensure_add_apt_repository
  if command -v add-apt-repository >/dev/null 2>&1; then
    echo "keyd not in default repos; adding ppa:keyd-team/ppa"
    sudo add-apt-repository -y ppa:keyd-team/ppa
    sudo apt update -qq
  else
    echo "WARN: keyd not available and add-apt-repository not found"
  fi
fi
{{- end }}
{{- if $needsFastfetch }}

if ! apt show fastfetch >/dev/null 2>&1; then
  ensure_add_apt_repository
  if command -v add-apt-repository >/dev/null 2>&1; then
    echo "fastfetch not in default repos; adding ppa:zhangsongcui3371/fastfetch"
    sudo add-apt-repository -y ppa:zhangsongcui3371/fastfetch
    sudo apt update -qq
  else
    echo "WARN: fastfetch not available and add-apt-repository not found"
  fi
fi
{{- end }}

core_pkgs=(
{{- if env "CHEZMOI_CI" }}
{{- range .packages.ubuntu.apt_ci }}
{{- if not (index $aptExcludeMap .) }}
  {{ . }}
{{- end }}
{{- end }}
{{- else if $p.packages }}
{{- range $p.packages }}
{{- if not (index $aptExcludeMap .) }}
  {{ . }}
{{- end }}
{{- end }}
{{- else }}
{{- range .packages.ubuntu.apt }}
{{- if not (index $aptExcludeMap .) }}
  {{ . }}
{{- end }}
{{- end }}
{{- end }}
)
available_pkgs=()
unavailable_pkgs=()
for pkg in "${core_pkgs[@]}"; do
  candidate="$(apt_pkg_candidate "$pkg")" || candidate=""
  if [[ -n "$candidate" && "$candidate" != "(none)" ]]; then
    available_pkgs+=("$pkg")
  else
    unavailable_pkgs+=("$pkg")
  fi
done
if ((${#unavailable_pkgs[@]})); then
  echo "Skipping ${#unavailable_pkgs[@]} core package(s) with no install candidate (install-tools may provide fallbacks): ${unavailable_pkgs[*]}"
fi
if is_wsl; then
  echo "WSL detected: skipping Wayland, GDM, and other graphical-session packages"
  drop_wsl_graphical_pkgs
fi
if ((${#available_pkgs[@]})); then
  sudo apt install -y -qq --no-install-recommends "${available_pkgs[@]}"
fi

echo "core apt packages installed"
{{- if not (env "CHEZMOI_CI") }}
{{- with index . "apt_manual" }}
{{- with .packages }}

# Manually-tracked packages (see scripts/apt-manual-sync). Some originate from
# third-party repos (Docker, ngrok, Proton VPN, Huion, ...) that are not
# configured on every host (e.g. WSL). Filter to packages apt can actually
# resolve and install them best-effort so a missing repo never aborts the apply.
manual_pkgs=(
{{- range $pkg, $meta := . }}
{{- if and (eq $meta.status "install") (not (index $aptExcludeMap $pkg)) }}
  {{ $pkg }}
{{- end }}
{{- end }}
)
available_pkgs=()
unavailable_pkgs=()
for pkg in "${manual_pkgs[@]}"; do
  candidate="$(apt_pkg_candidate "$pkg")" || candidate=""
  if [[ -n "$candidate" && "$candidate" != "(none)" ]]; then
    available_pkgs+=("$pkg")
  else
    unavailable_pkgs+=("$pkg")
  fi
done
if ((${#unavailable_pkgs[@]})); then
  echo "Skipping ${#unavailable_pkgs[@]} manual package(s) with no install candidate (third-party repo not configured?): ${unavailable_pkgs[*]}"
fi
if is_wsl; then
  drop_wsl_graphical_pkgs
fi
if ((${#available_pkgs[@]})); then
  sudo apt install -y -qq --no-install-recommends "${available_pkgs[@]}" \
    || echo "WARN: one or more manual packages failed to install"
fi
{{- end }}
{{- end }}
{{- end }}

{{- if and (not (env "CHEZMOI_CI")) (index $p.features "desktop_sway") }}
# autorandr (xrandr/X11) conflicts with kanshi on sway Wayland sessions.
if dpkg-query -W -f='${Status}' autorandr 2>/dev/null | grep -q 'install ok installed'; then
  echo "Removing autorandr (conflicts with kanshi on sway Wayland)"
  sudo apt-get remove -y --purge autorandr
fi
{{- end }}

echo "apt packages installed"
{{ else if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/setup-catalog.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/profile.macos.example.yaml" | sha256sum }}
# hash: {{ include ".chezmoidata/profile-ci-macos.yaml" | sha256sum }}

{{- $p := includeTemplate "profile.tpl" . | fromYaml }}

ensure_brew() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    return 0
  fi
  if [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
    return 0
  fi
  echo "Homebrew not found; installing (NONINTERACTIVE=1)"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  command -v brew >/dev/null 2>&1
}

ensure_brew

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1

formulae=(
{{- if env "CHEZMOI_CI" }}
{{- range .packages.darwin.brew_ci }}
  {{ . }}
{{- end }}
{{- else if $p.packages }}
{{- range $p.packages }}
  {{ . }}
{{- end }}
{{- else }}
{{- range .packages.darwin.brew }}
  {{ . }}
{{- end }}
{{- end }}
)

to_install=()
for formula in "${formulae[@]}"; do
  if brew list --formula "$formula" >/dev/null 2>&1; then
    echo "brew: $formula already installed"
  else
    to_install+=("$formula")
  fi
done
if ((${#to_install[@]})); then
  echo "Installing Homebrew formulae: ${to_install[*]}"
  brew install --formula "${to_install[@]}"
fi

echo "Homebrew formulae installed"
{{ end -}}
