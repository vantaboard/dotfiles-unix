# Pointer acceleration overrides (libinput; Sway per-device settings in input-devices.conf).
{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{- $inputDevices := index $p "input_devices" | default dict -}}
{{- $pointers := index $inputDevices "pointers" | default list -}}
{{- range $i, $ptr := $pointers }}
[chezmoi-pointer-{{ $i }}]
MatchName={{ $ptr.match }}
MatchUdevType=mouse
AttrAccelSpeed={{ $ptr.pointer_accel }}

{{- end }}
