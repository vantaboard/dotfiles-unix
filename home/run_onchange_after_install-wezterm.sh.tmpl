{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $p := includeTemplate "profile.tpl" . | fromYaml }}
{{- $f := $p.features -}}
{{- if index $f "wezterm" -}}
#!/bin/bash
set -euo pipefail

# hash: wezterm-v5-darwin-cask

if [[ "${CHEZMOI_CI:-}" == "1" ]]; then
  echo "CHEZMOI_CI=1; skipping wezterm install"
  exit 0
fi

HOME_DIR="{{ .chezmoi.homeDir }}"
LOCAL_BIN="$HOME_DIR/.local/bin"
LEGACY_APPIMAGE="$HOME_DIR/.local/share/wezterm/wezterm.AppImage"
LEGACY_BIN="$LOCAL_BIN/wezterm"
WEZTERM_APT_KEYRING="/usr/share/keyrings/wezterm-fury.gpg"
WEZTERM_APT_LIST="/etc/apt/sources.list.d/wezterm.list"

wezterm_cmd() {
{{- if eq .chezmoi.os "darwin" }}
  if command -v wezterm >/dev/null 2>&1; then
    command -v wezterm
    return 0
  fi
  if [[ -x /Applications/WezTerm.app/Contents/MacOS/wezterm ]]; then
    printf '%s\n' /Applications/WezTerm.app/Contents/MacOS/wezterm
    return 0
  fi
  if [[ -x "$HOME_DIR/Applications/WezTerm.app/Contents/MacOS/wezterm" ]]; then
    printf '%s\n' "$HOME_DIR/Applications/WezTerm.app/Contents/MacOS/wezterm"
    return 0
  fi
  return 1
{{- else }}
  [[ -x /usr/bin/wezterm ]] || return 1
  printf '%s\n' /usr/bin/wezterm
{{- end }}
}

wezterm_usable() {
  local bin
  bin="$(wezterm_cmd 2>/dev/null || true)"
  [[ -n "$bin" ]] && "$bin" --version >/dev/null 2>&1
}

install_wezterm_terminfo() {
  local terminfo_dir="$HOME_DIR/.terminfo"
  local terminfo_file
  if ! command -v tic >/dev/null 2>&1; then
    echo "WARN: tic not found; skipping wezterm terminfo install"
    return 0
  fi
  terminfo_file="$(mktemp)"
  if curl -fsSL "https://raw.githubusercontent.com/wezterm/wezterm/main/termwiz/data/wezterm.terminfo" -o "$terminfo_file"; then
    mkdir -p "$terminfo_dir"
    tic -x -o "$terminfo_dir" "$terminfo_file"
    echo "wezterm terminfo installed in $terminfo_dir"
  else
    echo "WARN: could not download wezterm.terminfo"
  fi
  rm -f "$terminfo_file"
}

{{- if eq .chezmoi.os "darwin" }}
ensure_brew() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    return 0
  fi
  if [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
    return 0
  fi
  echo "WARN: Homebrew not found; cannot install wezterm cask"
  return 1
}

install_wezterm_darwin() {
  ensure_brew || return 0
  export HOMEBREW_NO_AUTO_UPDATE=1
  export HOMEBREW_NO_ENV_HINTS=1

  if brew list --cask wezterm >/dev/null 2>&1; then
    echo "wezterm cask already installed"
  else
    echo "Installing wezterm via Homebrew cask..."
    brew install --cask wezterm
  fi

  # Config expects FiraMono Nerd Font Mono (same as Linux desktop).
  if brew list --cask font-fira-mono-nerd-font >/dev/null 2>&1; then
    echo "font-fira-mono-nerd-font already installed"
  else
    echo "Installing FiraMono Nerd Font for WezTerm..."
    brew install --cask font-fira-mono-nerd-font || \
      echo "WARN: could not install font-fira-mono-nerd-font"
  fi
}

wezterm_version() {
  local bin
  bin="$(wezterm_cmd 2>/dev/null || true)"
  [[ -n "$bin" ]] && "$bin" --version | head -1
}

if wezterm_usable; then
  echo "wezterm already installed: $(wezterm_version)"
  install_wezterm_terminfo
  # Still ensure the Nerd Font is present for the shared config.
  ensure_brew && {
    export HOMEBREW_NO_AUTO_UPDATE=1
    export HOMEBREW_NO_ENV_HINTS=1
    brew list --cask font-fira-mono-nerd-font >/dev/null 2>&1 || \
      brew install --cask font-fira-mono-nerd-font || true
  }
  exit 0
fi

install_wezterm_darwin

if wezterm_usable; then
  install_wezterm_terminfo
  echo "wezterm installed: $(wezterm_version)"
else
  echo "WARN: wezterm install failed"
  exit 0
fi
{{- else }}
remove_legacy_appimage() {
  rm -f "$LEGACY_BIN" "$LEGACY_APPIMAGE"
  rmdir "$HOME_DIR/.local/share/wezterm" 2>/dev/null || true
}

setup_wezterm_apt_repo() {
  if [[ -f "$WEZTERM_APT_KEYRING" && -f "$WEZTERM_APT_LIST" ]]; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "WARN: curl not found; skipping wezterm apt repo setup"
    return 1
  fi
  echo "Setting up wezterm apt repository..."
  curl -fsSL https://apt.fury.io/wez/gpg.key \
    | sudo gpg --yes --dearmor -o "$WEZTERM_APT_KEYRING"
  echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' \
    | sudo tee "$WEZTERM_APT_LIST" >/dev/null
  sudo chmod 644 "$WEZTERM_APT_KEYRING"
}

if wezterm_usable; then
  echo "wezterm already installed: $(/usr/bin/wezterm --version | head -1)"
  remove_legacy_appimage
  install_wezterm_terminfo
  exit 0
fi

remove_legacy_appimage

if ! setup_wezterm_apt_repo; then
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
sudo apt update -qq
sudo apt install -y -qq wezterm

if wezterm_usable; then
  install_wezterm_terminfo
  echo "wezterm installed: $(/usr/bin/wezterm --version | head -1)"
else
  echo "WARN: wezterm install failed"
  exit 0
fi
{{- end }}
{{- end -}}
{{ end -}}
