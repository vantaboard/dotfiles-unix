{{ if and (eq .chezmoi.os "linux") -}}
{{- $p := .profile_example -}}
{{- if eq .chezmoi.os "android" -}}{{- $p = .profile_termux_example -}}{{- end -}}
{{- if index . "profile" -}}
{{-   if eq .chezmoi.os "android" -}}{{- $p = mergeOverwrite $p .profile -}}
{{-   else -}}{{- $p = .profile -}}
{{-   end -}}
{{- end -}}
{{- if env "CHEZMOI_CI" -}}{{- $p = .profile_ci -}}{{- end -}}
{{- if index . "profile_host" -}}{{- $p = mergeOverwrite $p .profile_host -}}{{- end -}}
{{- if eq .chezmoi.os "android" -}}
{{- $p = mergeOverwrite $p (dict "features" (mergeOverwrite $p.features .profile_termux_example.features)) -}}
{{- end -}}
{{- $f := $p.features -}}
{{- if index $f "wezterm" -}}
#!/bin/bash
set -euo pipefail

# hash: wezterm-v4

if [[ "${CHEZMOI_CI:-}" == "1" ]]; then
  echo "CHEZMOI_CI=1; skipping wezterm install"
  exit 0
fi

HOME_DIR="{{ .chezmoi.homeDir }}"
LOCAL_BIN="$HOME_DIR/.local/bin"
LEGACY_APPIMAGE="$HOME_DIR/.local/share/wezterm/wezterm.AppImage"
LEGACY_BIN="$LOCAL_BIN/wezterm"
WEZTERM_APT_KEYRING="/usr/share/keyrings/wezterm-fury.gpg"
WEZTERM_APT_LIST="/etc/apt/sources.list.d/wezterm.list"

wezterm_usable() {
  [[ -x /usr/bin/wezterm ]] && /usr/bin/wezterm --version >/dev/null 2>&1
}

remove_legacy_appimage() {
  rm -f "$LEGACY_BIN" "$LEGACY_APPIMAGE"
  rmdir "$HOME_DIR/.local/share/wezterm" 2>/dev/null || true
}

install_wezterm_terminfo() {
  local terminfo_dir="$HOME_DIR/.terminfo"
  local terminfo_file
  if ! command -v tic >/dev/null 2>&1; then
    echo "WARN: tic not found; skipping wezterm terminfo install"
    return 0
  fi
  terminfo_file="$(mktemp)"
  if curl -fsSL "https://raw.githubusercontent.com/wezterm/wezterm/main/termwiz/data/wezterm.terminfo" -o "$terminfo_file"; then
    mkdir -p "$terminfo_dir"
    tic -x -o "$terminfo_dir" "$terminfo_file"
    echo "wezterm terminfo installed in $terminfo_dir"
  else
    echo "WARN: could not download wezterm.terminfo"
  fi
  rm -f "$terminfo_file"
}

setup_wezterm_apt_repo() {
  if [[ -f "$WEZTERM_APT_KEYRING" && -f "$WEZTERM_APT_LIST" ]]; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "WARN: curl not found; skipping wezterm apt repo setup"
    return 1
  fi
  echo "Setting up wezterm apt repository..."
  curl -fsSL https://apt.fury.io/wez/gpg.key \
    | sudo gpg --yes --dearmor -o "$WEZTERM_APT_KEYRING"
  echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' \
    | sudo tee "$WEZTERM_APT_LIST" >/dev/null
  sudo chmod 644 "$WEZTERM_APT_KEYRING"
}

if wezterm_usable; then
  echo "wezterm already installed: $(/usr/bin/wezterm --version | head -1)"
  remove_legacy_appimage
  install_wezterm_terminfo
  exit 0
fi

remove_legacy_appimage

if ! setup_wezterm_apt_repo; then
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
sudo apt update -qq
sudo apt install -y -qq wezterm

if wezterm_usable; then
  install_wezterm_terminfo
  echo "wezterm installed: $(/usr/bin/wezterm --version | head -1)"
else
  echo "WARN: wezterm install failed"
  exit 0
fi
{{- end -}}
{{ end -}}
