# aichat → local llama-swap (OpenAI-compatible)
# Docs: https://github.com/sigoden/aichat/wiki/Configuration-Guide
#
# REPL:  aichat                 (fzf session picker via ~/.local/bin/aichat)
# One-shot: aichat "hello"
# Sessions: aichat -s name
# Tools: DuckDuckGo web_search via llm-functions (~/.config/aichat/functions)

model: llama-swap:chat
stream: true
save: true
save_session: true
keybindings: emacs
highlight: true
wrap: auto
function_calling: true
use_tools: web_search
compress_threshold: 8000

clients:
  - type: openai-compatible
    name: llama-swap
    api_base: http://127.0.0.1:9292/v1
    # llama-swap ignores auth; aichat wants a non-empty key for some paths
    api_key: local
    models:
      - name: chat
        max_input_tokens: 16384
        supports_function_calling: true
      - name: coder
        max_input_tokens: 8192
