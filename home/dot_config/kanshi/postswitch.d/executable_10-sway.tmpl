#!/usr/bin/bash
# Apply the matching profile.displays layout to sway workspaces after kanshi.
set -euo pipefail
OTD_ARTIST="0:0:OpenTabletDriver_Virtual_Artist_Tablet"
OTD_POINTER="0:0:OpenTabletDriver_Virtual_Tablet"

matched="$("$HOME/.local/bin/sway-displays" match)"
laptop_name="$(jq -r '.laptop.name' <<<"$matched")"
laptop_mode="$(jq -r '.laptop.mode // empty' <<<"$matched")"
laptop_action="$(jq -r '.laptop.action' <<<"$matched")"
kamvas="$(jq -r '[.outputs[] | select(.map_tablet == true) | .name][0] // empty' <<<"$matched")"
mapfile -t MONITOR_ARRAY < <(jq -r '.outputs[].name' <<<"$matched")

LAYOUT_OUTPUT=""
if [[ "${#MONITOR_ARRAY[@]}" -eq 0 ]]; then
    MONITOR_ARRAY=("$laptop_name")
    LAYOUT_OUTPUT="output ${laptop_name} enable"
    [[ -n "$laptop_mode" ]] && LAYOUT_OUTPUT+=" mode ${laptop_mode}"
    LAYOUT_OUTPUT+=" position 0,0\n"
else
    while IFS=$'\t' read -r name x y; do
        LAYOUT_OUTPUT+="output ${name} position ${x} ${y}\n"
    done < <(jq -r '.outputs[] | [.name, (.x|tostring), (.y|tostring)] | @tsv' <<<"$matched")
    if [[ "$laptop_action" == "disable" ]]; then
        LAYOUT_OUTPUT+="output ${laptop_name} disable\n"
    fi
fi

MOVE_KEYS=("b" "n" "m")
WORKSPACE_NAMES=("web" "code" "media" "comms" "misc" "av" "other" "other")

CONFIG_OUTPUT="############# Auto-generated for use with kanshi #############\n"
CONFIG_OUTPUT+="${LAYOUT_OUTPUT}\n"

# Sway substitutes variables at parse time in source order, so every `set` must
# come before the first line that references it. A `workspace $ws0 ...` emitted
# before `set $ws0 ...` would be created with the literal name "$ws0".
for i in $(seq 0 $((${#MONITOR_ARRAY[@]}-1))); do
    CONFIG_OUTPUT+="set \$screen$i ${MONITOR_ARRAY[$i]}\n"
done

# Artist Mode virtual tablet is mapped by Sway. Pin it to the Kamvas so the
# pen is 1:1 with that output instead of stretching across the whole desktop.
if [[ -n "${kamvas:-}" ]]; then
    CONFIG_OUTPUT+="input \"${OTD_ARTIST}\" map_to_output ${kamvas}\n"
    CONFIG_OUTPUT+="input \"${OTD_POINTER}\" map_to_output ${kamvas}\n"
fi

for i in {0..7}; do
    CONFIG_OUTPUT+="set \$ws$i $((i + 1)):${WORKSPACE_NAMES[$i]}\n"
done

for i in $(seq 0 $((${#MONITOR_ARRAY[@]}-1))); do
    if [ $i -lt ${#MOVE_KEYS[@]} ]; then
        CONFIG_OUTPUT+="bindsym \$mod+shift+${MOVE_KEYS[$i]} move workspace to output \$screen$i\n"
    fi
done

# Default output for empty or unassigned workspaces. With 3 outputs: left 3/6/7,
# middle 2/5/8, right 1/4. Otherwise map workspace i to screen i (capped).
if [[ "${#MONITOR_ARRAY[@]}" -ge 3 ]]; then
    WS_OUTPUT_SCREEN=(2 1 0 2 1 0 0 1)
else
    WS_OUTPUT_SCREEN=()
    for i in {0..7}; do
        if [ "$i" -lt "${#MONITOR_ARRAY[@]}" ]; then
            WS_OUTPUT_SCREEN[$i]=$i
        fi
    done
fi

for i in {0..7}; do
    if [ -n "${WS_OUTPUT_SCREEN[$i]:-}" ]; then
        screen_idx=${WS_OUTPUT_SCREEN[$i]}
        CONFIG_OUTPUT+="workspace \$ws$i output \$screen$screen_idx\n"
    fi
done

for i in {0..7}; do
    INDEX_FROM_ONE=$((i + 1))
    WS="\$ws$i"

    CONFIG_OUTPUT+="bindsym \$mod+$INDEX_FROM_ONE workspace $WS\n"
    CONFIG_OUTPUT+="bindsym \$mod+Ctrl+$INDEX_FROM_ONE move container to workspace $WS\n"
    CONFIG_OUTPUT+="bindsym \$mod+Shift+$INDEX_FROM_ONE move container to workspace $WS; workspace $WS\n"
done

CONFIG_FILE="$HOME/.config/sway/config"
NEW_BLOCK=$(printf '%b' "$CONFIG_OUTPUT")
OLD_BLOCK=$(sed -n '/^############# Auto-generated for use with kanshi #############/,$p' "$CONFIG_FILE" 2>/dev/null || true)

if [[ -n "$OLD_BLOCK" && "$NEW_BLOCK" == "$OLD_BLOCK" ]]; then
    # The config text is unchanged (e.g. a normal reboot into the same layout),
    # so a reload is unnecessary. But at boot the externals often come up after
    # sway already ran its exec_always wallpaper/bar against an early output
    # state, so re-apply them now that kanshi has positioned the monitors.
    if [ -n "${SWAYSOCK:-}" ]; then
        "$HOME/.local/bin/sway-docked-layout"
        "$HOME/.local/bin/sway-wallpaper"
        "$HOME/.local/bin/waybar-restart"
    fi
    echo "sway monitor layout unchanged; refreshed wallpaper and bar."
    exit 0
fi

sed -i '/############# Auto-generated for use with kanshi #############/,$d' "$CONFIG_FILE"
printf '%b' "$CONFIG_OUTPUT" >> "$CONFIG_FILE"

if [ -n "${SWAYSOCK:-}" ]; then
    swaymsg reload
    "$HOME/.local/bin/sway-docked-layout"
    "$HOME/.local/bin/sway-wallpaper"
    "$HOME/.local/bin/waybar-restart"
fi

echo "sway config reloaded."
