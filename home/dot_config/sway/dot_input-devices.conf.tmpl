# Per-device input settings (Wayland / Sway).
# Pointer acceleration also mirrored in system/libinput/local-overrides.quirks.
{{- $p := includeTemplate "profile.tpl" . | fromYaml -}}
{{- $inputDevices := index $p "input_devices" | default dict -}}
{{- $pointers := index $inputDevices "pointers" | default list -}}
{{- range $pointers }}
input "{{ .match }}" pointer_accel {{ .pointer_accel }}
{{- end }}
