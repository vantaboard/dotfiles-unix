{{ if eq .chezmoi.os "linux" -}}
{{ $p := includeTemplate "profile.tpl" . | fromYaml }}
{{- $f := $p.features -}}
{{- if index $f "cursor" -}}
#!/bin/bash
set -euo pipefail

# hash: cursor-dev-appimage-v4

if [[ "${CHEZMOI_CI:-}" == "1" ]]; then
  echo "CHEZMOI_CI=1; skipping Cursor AppImage install"
  exit 0
fi

HOME_DIR="{{ .chezmoi.homeDir }}"
LOCAL_BIN="$HOME_DIR/.local/bin"
INSTALL_DIR="$HOME_DIR/.local/opt/cursor-dev"
CACHE_DIR="$HOME_DIR/.cache/cursor-dev-install"
APPIMAGE="$INSTALL_DIR/Cursor.AppImage"
EXTRACT_DIR="$INSTALL_DIR/extracted"
VERSION_FILE="$INSTALL_DIR/version"
UPDATE_CHANNEL="dev"
UPDATE_BASE_VERSION="${CURSOR_UPDATE_BASE_VERSION:-0.0.0}"
UPDATE_SEED_SHA="${CURSOR_UPDATE_SEED_SHA:-b596604857d12725c2c353227badabbfd503ace59109393916d369c399dfd1a6}"
UPDATE_URL="https://api2.cursor.sh/updates/api/update/linux-x64/cursor/${UPDATE_BASE_VERSION}/${UPDATE_SEED_SHA}/${UPDATE_CHANNEL}"

case "$(uname -m)" in
  x86_64) ;;
  *)
    echo "WARN: unsupported architecture $(uname -m); skipping Cursor AppImage install"
    exit 0
    ;;
esac

if ! command -v curl >/dev/null 2>&1; then
  echo "WARN: curl not found; skipping Cursor AppImage install"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "WARN: jq not found; skipping Cursor AppImage install"
  exit 0
fi

metadata="$(curl -fsSL "$UPDATE_URL")"
target_version="$(jq -r '.productVersion // .version // empty' <<<"$metadata")"
update_asset_url="$(jq -r '.url // empty' <<<"$metadata")"

if [[ -z "$target_version" || -z "$update_asset_url" || "$update_asset_url" == "null" ]]; then
  echo "WARN: Cursor update API did not return a downloadable ${UPDATE_CHANNEL} AppImage"
  exit 0
fi

download_url="$update_asset_url"
if [[ "$download_url" == *.AppImage.zsync ]]; then
  download_url="${download_url%.zsync}"
fi

if [[ "$download_url" != *.AppImage ]]; then
  echo "WARN: Cursor update URL is not an AppImage: $download_url"
  exit 0
fi

link_cursor() {
  mkdir -p "$LOCAL_BIN"
  rm -f "$LOCAL_BIN/cursor"
  cat > "$LOCAL_BIN/cursor" <<EOF
#!/bin/bash
set -euo pipefail
exec "$EXTRACT_DIR/AppRun" --no-sandbox "\$@"
EOF
  chmod +x "$LOCAL_BIN/cursor"
}

register_url_handler() {
  local handler="$HOME_DIR/.local/share/applications/cursor-url-handler.desktop"

  if [[ ! -f "$handler" ]]; then
    echo "WARN: $handler missing; skipping cursor:// handler registration"
    return 0
  fi

  if ! command -v xdg-mime >/dev/null 2>&1; then
    echo "WARN: xdg-mime not found; install xdg-utils to register cursor:// handler"
    return 0
  fi

  xdg-mime default cursor-url-handler.desktop x-scheme-handler/cursor
  echo "Registered cursor:// URL handler -> $LOCAL_BIN/cursor --open-url"
}

extract_appimage() {
  local image="$1"
  local tmp_extract

  mkdir -p "$CACHE_DIR"
  tmp_extract="$(mktemp -d "${CACHE_DIR}/extract.XXXXXX")"
  echo "Extracting Cursor AppImage..."
  if ! (
    cd "$tmp_extract"
    timeout 180 "$image" --appimage-extract >/dev/null
  ); then
    rm -rf "$tmp_extract"
    echo "WARN: failed to extract Cursor AppImage; keeping the installed copy"
    return 1
  fi
  rm -rf "$EXTRACT_DIR"
  mv "$tmp_extract/squashfs-root" "$EXTRACT_DIR"
  rmdir "$tmp_extract"
}

download_appimage() {
  echo "Downloading Cursor ${UPDATE_CHANNEL} ${target_version}..."
  if ! curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 \
    --speed-limit 10000 --speed-time 30 -# \
    -o "$tmp_file" "$download_url"; then
    echo "WARN: failed to download Cursor ${target_version}; keeping the installed copy"
    return 1
  fi
  chmod +x "$tmp_file"
}

appimage_current() {
  [[ -x "$APPIMAGE" ]] || return 1
  [[ -f "$VERSION_FILE" && "$(cat "$VERSION_FILE")" == "$target_version" ]] || return 1
  [[ "$(wc -c < "$APPIMAGE")" -gt 100000000 ]]
}

extracted_current() {
  [[ -x "$EXTRACT_DIR/AppRun" ]] || return 1
  [[ -f "$EXTRACT_DIR/usr/share/cursor/resources/app/out/main.js" ]]
}

mkdir -p "$INSTALL_DIR" "$CACHE_DIR"
tmp_file="$(mktemp "${CACHE_DIR}/Cursor.AppImage.XXXXXX")"
cleanup() { rm -f "$tmp_file"; }
trap cleanup EXIT

if appimage_current; then
  echo "Cursor ${UPDATE_CHANNEL} ${target_version} already installed at $APPIMAGE"
  if ! extracted_current; then
    extract_appimage "$APPIMAGE" || exit 0
  fi
  link_cursor
  register_url_handler
  exit 0
fi

download_appimage || exit 0
extract_appimage "$tmp_file" || exit 0
mv "$tmp_file" "$APPIMAGE"
printf '%s\n' "$target_version" > "$VERSION_FILE"
link_cursor
register_url_handler

echo "Cursor ${UPDATE_CHANNEL} ${target_version} installed; cursor -> $EXTRACT_DIR/AppRun"
{{- end -}}
{{ end -}}
